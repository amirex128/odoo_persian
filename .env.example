# PostgreSQL / Odoo database connection used by the official Odoo image entrypoint.
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=replace-with-a-strong-password

# Odoo database-manager master password. Never commit the real value.
ODOO_ADMIN_PASSWD=replace-with-a-different-strong-password
ODOO_LIST_DB=True

# Local host ports only.
ODOO_PORT=8069
ODOO_LONGPOLLING_PORT=8072
