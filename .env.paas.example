# PaaS runtime environment
# PostgreSQL runs as a separate managed/external service.
# Set these exact variables in the PaaS Environment/Secrets section.
POSTGRES_HOST=database-service.internal
POSTGRES_PORT=5432
POSTGRES_USER=odoo
POSTGRES_PASSWORD=replace-with-the-postgres-role-password

# Odoo database manager master password; use a separate secret.
ODOO_ADMIN_PASSWD=replace-with-a-strong-master-password
ODOO_LIST_DB=False

# Official rule of thumb is (CPU * 2) + 1, but RAM is the limiting factor.
# Start with 2 workers and tune from metrics; do not blindly maximize this.
ODOO_WORKERS=2
ODOO_MAX_CRON_THREADS=1

# The PaaS should expose this container port.
ODOO_HTTP_PORT=8069
ODOO_LONGPOLLING_PORT=8072
