# PaaS runtime environment
# PostgreSQL runs as a separate managed/external service.
# Set these exact variables in the PaaS Environment/Secrets section.
POSTGRES_HOST=database-iwo-service
POSTGRES_PORT=5432
POSTGRES_USER=odoo
POSTGRES_PASSWORD=hBn7seWC1nKMgywD8lUw

# Odoo database manager master password; use a separate secret.
ODOO_ADMIN_PASSWD=hBn7seWC1nKMgywD8lUw
ODOO_LIST_DB=False

# The PaaS should expose this container port.
ODOO_HTTP_PORT=8069
ODOO_LONGPOLLING_PORT=8072
