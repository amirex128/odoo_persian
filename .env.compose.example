# Local Docker Compose environment
# Official pgvector image tag for the PostgreSQL 18 line.
# The registry currently publishes a major-line tag, not a PostgreSQL 18.1 tag.
POSTGRES_IMAGE=pgvector/pgvector:0.8.6-pg18-trixie
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=replace-with-a-strong-local-password

ODOO_ADMIN_PASSWD=replace-with-a-different-local-master-password
ODOO_LIST_DB=True
ODOO_PORT=8069
ODOO_LONGPOLLING_PORT=8072
